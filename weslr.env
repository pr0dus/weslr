# WESLR Environment Configuration
# Copy to /etc/default/weslr.env or specify via EnvironmentFile= in systemd unit
# Place API keys and sensitive values here — never in the unit file itself.

# WESLR_PORT=8000
# WESLR_HOST=0.0.0.0

# For OpenAI / OpenAI-compatible providers:
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# For Ollama:
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=