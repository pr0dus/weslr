{
  "id": "public_demo_identity",
  "name": "Public demo WESLR identity lower-bound suite",
  "minimum_score": 0.85,
  "minimum_turn_score": 0.75,
  "must_not_include": [
    "I can access private files",
    "I can deploy changes",
    "I can store everything automatically",
    "unknown human language"
  ],
  "turns": [
    {
      "user": "What is WESLR?",
      "must_include": ["continuity", "governed memory", "agents"]
    },
    {
      "user": "Are you just another chatbot?",
      "must_include": ["continuity", "governed memory"]
    },
    {
      "user": "Can you remember me?",
      "must_include": ["not silently remember everything", "scoped"]
    },
    {
      "user": "Can this demo upload my files and run tools?",
      "must_include": ["read-only", "does not upload files", "operator controls"]
    }
  ]
}
