<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Protected WESLR Workspace</title>
  <style>
    :root {
      --bg-primary: #071018;
      --bg-secondary: #0b111b;
      --bg-tertiary: #0f172a;
      --border-subtle: rgba(148, 163, 184, 0.18);
      --border-muted: rgba(148, 163, 184, 0.12);
      --text-primary: #e7eef8;
      --text-secondary: #cbd5e1;
      --text-muted: #94a3b8;
      --accent-blue: #38bdf8;
      --accent-blue-500: #0ea5e9;
      --accent-green: #22c55e;
      --accent-amber: #f59e0b;
      --accent-red: #ef4444;
      --radius-lg: 24px;
      --radius-md: 16px;
      --radius-sm: 12px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background: radial-gradient(circle at top left, rgba(59,130,246,0.20), transparent 32rem), linear-gradient(180deg, var(--bg-primary) 0%, var(--bg-secondary) 100%);
      color: var(--text-primary);
      min-height: 100vh;
      overflow: hidden;
    }

    /* Protected Header */
    .app-header {
      position: fixed;
      top: 0; left: 0; right: 0;
      height: 56px;
      background: rgba(7, 16, 24, 0.92);
      border-bottom: 1px solid var(--border-subtle);
      backdrop-filter: blur(12px);
      z-index: 100;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 1rem;
    }
    .header-left {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    .logo {
      width: 32px; height: 32px;
      background: linear-gradient(135deg, var(--accent-blue), var(--accent-blue-500));
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      font-size: 18px;
      color: #071018;
    }
    .app-title {
      font-size: 0.92rem;
      font-weight: 700;
      letter-spacing: -0.02em;
    }
    .status-pill {
      padding: 0.25rem 0.6rem;
      background: rgba(239, 68, 68, 0.12);
      border: 1px solid rgba(239, 68, 68, 0.28);
      border-radius: 999px;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: #fca5a5;
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }
    .status-dot {
      width: 6px; height: 6px;
      background: var(--accent-red);
      border-radius: 50%;
    }

    /* Main Layout */
    .app-shell {
      display: flex;
      flex-direction: row;
      height: calc(100vh - 56px);
      padding-top: 56px;
    }

    /* Left Sidebar */
    .sidebar {
      width: 280px;
      background: rgba(15, 23, 42, 0.72);
      border-right: 1px solid var(--border-subtle);
      display: flex;
      flex-direction: column;
    }
    .sidebar-header {
      padding: 1rem;
      border-bottom: 1px solid var(--border-subtle);
    }
    .sidebar-header h3 {
      font-size: 0.76rem;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--text-muted);
      font-weight: 700;
    }
    .project-list {
      flex: 1;
      padding: 0.5rem;
      overflow-y: auto;
    }
    .project-item {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.65rem 0.8rem;
      border-radius: var(--radius-sm);
      cursor: pointer;
      transition: background 0.15s;
      color: var(--text-secondary);
      font-size: 0.88rem;
    }
    .project-item:hover {
      background: rgba(59, 130, 246, 0.12);
      color: var(--accent-blue);
    }
    .project-item.active {
      background: rgba(59, 130, 246, 0.18);
      color: var(--accent-blue);
      border: 1px solid rgba(59, 130, 246, 0.28);
    }
    .project-item .icon {
      width: 10px; height: 10px;
      border-radius: 2px;
      background: var(--text-muted);
    }
    .project-item.active .icon {
      background: var(--accent-blue);
    }
    .project-new-btn {
      padding: 0.75rem 1rem;
      margin: 0.5rem;
      background: var(--accent-blue);
      color: var(--bg-primary);
      border: none;
      border-radius: var(--radius-sm);
      font-size: 0.82rem;
      font-weight: 700;
      cursor: pointer;
      transition: transform 0.15s, background 0.15s;
    }
    .project-new-btn:hover {
      transform: translateY(-1px);
      background: var(--accent-blue-500);
    }
    .project-new-btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
      transform: none;
    }

    /* Center Chat */
    .main-center {
      flex: 1;
      display: flex;
      flex-direction: column;
      min-width: 0;
      background: var(--bg-primary);
    }
    .active-project-header {
      padding: 0.85rem 1rem;
      border-bottom: 1px solid var(--border-subtle);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .project-title {
      font-size: 1rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      color: var(--text-primary);
    }
    .center-content {
      flex: 1;
      padding: 1rem;
      overflow-y: auto;
    }
    .empty-state {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      height: 100%;
      color: var(--text-muted);
    }
    .empty-state h2 {
      font-size: 1.5rem;
      font-weight: 700;
      margin-bottom: 0.5rem;
      color: var(--text-secondary);
    }
    .empty-state p {
      max-width: 480px;
      text-align: center;
      color: var(--text-muted);
      line-height: 1.6;
    }
    .chat-messages {
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
      max-width: 840px;
      margin: 0 auto;
    }
    .message {
      padding: 0.85rem 1rem;
      border-radius: var(--radius-md);
      max-width: 84%;
      line-height: 1.6;
      font-size: 0.94rem;
    }
    .message-assistant {
      background: rgba(59, 130, 246, 0.12);
      border: 1px solid rgba(59, 130, 246, 0.24);
      align-self: flex-start;
      border-radius: var(--radius-md) var(--radius-md) var(--radius-md) 4px;
    }
    .message-user {
      background: rgba(148, 163, 184, 0.12);
      border: 1px solid rgba(148, 163, 184, 0.24);
      align-self: flex-end;
      border-radius: var(--radius-md) var(--radius-md) 4px var(--radius-md);
    }
    .message-system {
      background: rgba(245, 158, 11, 0.12);
      border: 1px solid rgba(245, 158, 11, 0.24);
      align-self: stretch;
      border-radius: var(--radius-md);
      font-size: 0.88rem;
      color: var(--text-secondary);
    }
    .message-sent-at {
      display: block;
      margin-top: 0.25rem;
      font-size: 0.72rem;
      color: var(--text-muted);
    }

    /* Right Panel */
    .right-panel {
      width: 320px;
      background: var(--bg-tertiary);
      border-left: 1px solid var(--border-subtle);
      display: flex;
      flex-direction: column;
    }
    .panel-section {
      padding: 0.85rem 1rem;
      border-bottom: 1px solid var(--border-muted);
    }
    .panel-section h4 {
      font-size: 0.76rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--text-muted);
      font-weight: 700;
      margin-bottom: 0.6rem;
    }
    .panel-content {
      padding: 0.75rem 1rem;
      color: var(--text-secondary);
      font-size: 0.88rem;
    }
    .panel-content p {
      margin-bottom: 0.5rem;
      line-height: 1.5;
    }
    .panel-content .status-label {
      display: inline-block;
      padding: 0.25rem 0.5rem;
      border-radius: 4px;
      font-size: 0.72rem;
      margin-bottom: 0.25rem;
    }
    .status-available {
      background: rgba(34, 197, 94, 0.10);
      border: 1px solid rgba(34, 197, 94, 0.24);
      color: #bbf7d0;
    }
    .status-protected {
      background: rgba(59, 130, 246, 0.10);
      border: 1px solid rgba(59, 130, 246, 0.24);
      color: #bfdbfe;
    }
    .status-internal {
      background: rgba(245, 158, 11, 0.10);
      border: 1px solid rgba(245, 158, 11, 0.24);
      color: #fde68a;
    }
    .status-preview {
      background: rgba(239, 68, 68, 0.10);
      border: 1px dashed rgba(239, 68, 68, 0.28);
      color: #fca5a5;
    }
    .status-backend-blocked {
      background: rgba(75, 85, 99, 0.12);
      border: 1px solid rgba(75, 85, 99, 0.28);
      color: #9ca3af;
    }
    .status-approval {
      background: rgba(239, 68, 68, 0.12);
      border: 1px solid rgba(239, 68, 68, 0.28);
      color: #fca5a5;
    }

    /* Bottom Composer */
    .bottom-composer {
      background: rgba(7, 16, 24, 0.96);
      border-top: 1px solid var(--border-subtle);
      padding: 0.85rem 1rem;
      display: flex;
      flex-direction: column;
      gap: 0.65rem;
    }
    .composer-row {
      display: flex;
      gap: 0.65rem;
    }
    textarea#message-input {
      flex: 1;
      padding: 0.75rem 0.9rem;
      color: var(--text-primary);
      background: rgba(15, 23, 42, 0.92);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-sm);
      resize: none;
      height: 46px;
      min-height: 46px;
      max-height: 120px;
      font-family: inherit;
      font-size: 0.94rem;
      overflow-y: auto;
    }
    textarea#message-input:focus {
      outline: none;
      border-color: var(--accent-blue);
    }
    .composer-actions {
      display: flex;
      gap: 0.5rem;
      align-items: flex-end;
    }
    .icon-btn {
      width: 36px; height: 36px;
      border-radius: 8px;
      border: 1px solid var(--border-subtle);
      background: rgba(15, 23, 42, 0.78);
      color: var(--text-muted);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.15s;
    }
    .icon-btn:hover {
      background: rgba(59, 130, 246, 0.12);
      color: var(--accent-blue);
      border-color: rgba(59, 130, 246, 0.32);
    }
    .icon-btn:disabled {
      opacity: 0.4;
      cursor: not-allowed;
    }
    .send-btn {
      padding: 0.78rem 1.1rem;
      border: none;
      background: linear-gradient(135deg, var(--accent-blue), var(--accent-blue-500));
      color: var(--bg-primary);
      border-radius: var(--radius-sm);
      font-weight: 700;
      cursor: pointer;
      transition: transform 0.15s, background 0.15s;
    }
    .send-btn:hover {
      transform: translateY(-1px);
      background: linear-gradient(135deg, var(--accent-blue-500), var(--accent-blue));
    }
    .send-btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
      transform: none;
    }

    /* Modal */
    .modal-overlay {
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(7, 10, 18, 0.72);
      backdrop-filter: blur(8px);
      z-index: 200;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 1rem;
    }
    .modal-overlay.active {
      display: flex;
    }
    .modal {
      width: 100%;
      max-width: 480px;
      background: var(--bg-tertiary);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      box-shadow: 0 24px 80px rgba(0,0,0,0.4);
      overflow: hidden;
    }
    .modal-header {
      padding: 1rem 1.2rem;
      border-bottom: 1px solid var(--border-subtle);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .modal-header h3 {
      font-size: 1rem;
      font-weight: 700;
      letter-spacing: -0.02em;
    }
    .modal-body {
      padding: 1rem;
    }
    .form-group {
      margin-bottom: 0.85rem;
    }
    .form-group label {
      display: block;
      margin-bottom: 0.35rem;
      font-size: 0.82rem;
      color: var(--text-secondary);
      font-weight: 600;
    }
    .form-group input,
    .form-group select,
    .form-group textarea {
      width: 100%;
      padding: 0.65rem 0.8rem;
      color: var(--text-primary);
      background: rgba(7, 16, 24, 0.88);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-sm);
      font-family: inherit;
      font-size: 0.9rem;
    }
    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
      outline: none;
      border-color: var(--accent-blue);
    }
    .modal-footer {
      padding: 0.85rem 1rem;
      border-top: 1px solid var(--border-subtle);
      display: flex;
      justify-content: flex-end;
      gap: 0.65rem;
      background: rgba(7, 16, 24, 0.6);
    }
    .btn {
      padding: 0.65rem 1rem;
      border-radius: var(--radius-sm);
      font-size: 0.88rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.15s;
    }
    .btn-cancel {
      background: rgba(148, 163, 184, 0.10);
      color: var(--text-secondary);
      border: 1px solid var(--border-subtle);
    }
    .btn-cancel:hover {
      background: rgba(148, 163, 184, 0.18);
      color: var(--text-primary);
    }
    .btn-primary {
      background: var(--accent-blue);
      color: var(--bg-primary);
      border: none;
    }
    .btn-primary:hover {
      background: var(--accent-blue-500);
    }
    .btn-primary:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    /* Mobile Layout */
    @media (max-width: 768px) {
      .app-shell {
        flex-direction: column;
        height: calc(100vh - 56px);
      }
      .sidebar {
        display: none;
      }
      .right-panel {
        display: none;
      }
      .chat-messages {
        max-width: 100%;
      }
    }
  </style>
</head>
<body>
  <!-- App Header -->
  <header class="app-header">
    <div class="header-left">
      <div class="logo">W</div>
      <div class="app-title">Protected Workspace</div>
    </div>
    <div class="status-pill">
      <div class="status-dot"></div>
      Protected • Internal
    </div>
  </header>

  <!-- App Shell -->
  <div class="app-shell">
    <!-- Left Sidebar -->
    <aside class="sidebar">
      <div class="sidebar-header">
        <h3>Projects</h3>
      </div>
      <button class="project-new-btn" id="newProjectBtn">
        + New Project
      </button>
      <div class="project-list" id="projectList">
        <!-- Projects will be populated dynamically -->
        <div class="empty-state" style="padding: 1rem;">
          <p style="color: var(--text-muted);">No projects yet.<br>Create one to get started.</p>
        </div>
      </div>
    </aside>

    <!-- Center Chat -->
    <main class="main-center">
      <div class="active-project-header">
        <div class="project-title" id="activeProjectTitle">Select or create a project</div>
        <div class="status-pill" style="background: rgba(239, 68, 68, 0.08); border-color: rgba(239, 68, 68, 0.2); color: #fca5a5;">
          UI Preview
        </div>
      </div>
      <div class="center-content">
        <div class="empty-state">
          <h2>Protected Workspace Preview</h2>
          <p>This is a static preview of the protected WESLR chat app shell. Real backend wiring is not yet connected.</p>
          <div style="margin-top: 1rem;">
            <span class="status-label status-backend-blocked">Backend not connected</span>
            <span class="status-label status-approval">Requires approval</span>
          </div>
        </div>
        <div class="chat-messages" id="chatMessages" style="display: none;">
          <!-- Messages will be populated dynamically -->
        </div>
      </div>
      <div class="bottom-composer">
        <div class="composer-row">
          <textarea id="message-input" placeholder="Type a message..." disabled></textarea>
        </div>
        <div class="composer-actions">
          <button class="icon-btn" title="Context" disabled>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
          </button>
          <button class="icon-btn" title="Artifact" disabled>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
              <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
          </button>
          <button class="icon-btn" title="Evidence" disabled>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
              <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
          </button>
          <button class="icon-btn" title="Options" disabled>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="3"></circle>
              <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
            </svg>
          </button>
          <button class="send-btn" id="sendBtn" disabled>Send</button>
        </div>
      </div>
    </main>

    <!-- Right Panel -->
    <aside class="right-panel">
      <div class="panel-section">
        <h4>Project Options</h4>
        <div class="panel-content">
          <p class="status-label status-protected">Protected route</p>
          <p class="status-label status-backend-blocked">Backend not connected</p>
          <p>Visibility: Private</p>
          <p>Protection: Password (htpasswd)</p>
        </div>
      </div>
      <div class="panel-section">
        <h4>Artifacts</h4>
        <div class="panel-content">
          <p class="status-label status-approval">Requires approval</p>
          <p>Upload: Disabled</p>
          <p>List: Mock only</p>
        </div>
      </div>
      <div class="panel-section">
        <h4>Evidence/Context</h4>
        <div class="panel-content">
          <p class="status-label status-available">Available</p>
          <p>Continuity: Not active</p>
          <p>Memory: Mock</p>
        </div>
      </div>
      <div class="panel-section">
        <h4>Memory/Continuity</h4>
        <div class="panel-content">
          <p class="status-label status-preview">UI Preview</p>
          <p>Snapshots: None</p>
          <p>Restore: Disabled</p>
        </div>
      </div>
      <div class="panel-section">
        <h4>Settings</h4>
        <div class="panel-content">
          <p class="status-label status-backend-blocked">Backend blocked</p>
          <p>Theme: Dark</p>
          <p>Language: en</p>
        </div>
      </div>
    </aside>
  </div>

  <!-- New Project Modal -->
  <div class="modal-overlay" id="newProjectModal">
    <div class="modal">
      <div class="modal-header">
        <h3>Create New Project</h3>
        <button class="icon-btn" id="closeModalBtn" style="width: 24px; height: 24px;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
      <div class="modal-body">
        <div class="form-group">
          <label for="projectName">Project Name *</label>
          <input type="text" id="projectName" placeholder="e.g., Q3 Engineering Analysis" required>
        </div>
        <div class="form-group">
          <label for="projectType">Project Type</label>
          <select id="projectType">
            <option value="engineering">Engineering</option>
            <option value="research">Research</option>
            <option value="business">Business</option>
            <option value="other">Other</option>
          </select>
        </div>
        <div class="form-group">
          <label for="projectDescription">Description (optional)</label>
          <textarea id="projectDescription" rows="3" placeholder="Brief overview of this project..."></textarea>
        </div>
        <div class="form-group">
          <label for="projectPrivacy">Privacy</label>
          <select id="projectPrivacy" disabled>
            <option value="protected">Protected (Protected route)</option>
          </select>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-cancel" id="cancelProjectBtn">Cancel</button>
        <button class="btn btn-primary" id="createProjectBtn" disabled>Create Project</button>
      </div>
    </div>
  </div>

  <script>
    // Simple project list (mock)
    const projects = [
      { id: 'p-001', name: 'Q3 Engineering Analysis', type: 'engineering', active: false },
      { id: 'p-002', name: 'Market Research Q2', type: 'research', active: false },
      { id: 'p-003', name: 'Client Proposal Draft', type: 'business', active: false },
    ];

    // DOM elements
    const projectListEl = document.getElementById('projectList');
    const activeProjectTitleEl = document.getElementById('activeProjectTitle');
    const chatMessagesEl = document.getElementById('chatMessages');
    const newProjectBtn = document.getElementById('newProjectBtn');
    const newProjectModal = document.getElementById('newProjectModal');
    const closeModalBtn = document.getElementById('closeModalBtn');
    const cancelProjectBtn = document.getElementById('cancelProjectBtn');
    const createProjectBtn = document.getElementById('createProjectBtn');
    const projectNameInput = document.getElementById('projectName');
    const messageInput = document.getElementById('message-input');
    const sendBtn = document.getElementById('sendBtn');

    // Render project list
    function renderProjects() {
      if (projects.length === 0) {
        projectListEl.innerHTML = `
          <div class="empty-state" style="padding: 1rem;">
            <p style="color: var(--text-muted);">No projects yet.<br>Create one to get started.</p>
          </div>`;
        return;
      }

      projectListEl.innerHTML = projects.map((p, i) => `
        <div class="project-item ${p.active ? 'active' : ''}" data-id="${p.id}" onclick="selectProject('${p.id}')">
          <div class="icon"></div>
          <span>${i + 1}. ${p.name}</span>
        </div>
      `).join('');
    }

    // Select project
    function selectProject(id) {
      projects.forEach(p => p.active = (p.id === id));
      renderProjects();
      const project = projects.find(p => p.id === id);
      if (project) {
        activeProjectTitleEl.textContent = project.name;
        chatMessagesEl.style.display = 'block';
        chatMessagesEl.innerHTML = `
          <div class="message message-system">
            Welcome to <strong>${project.name}</strong> workspace.
            <span class="message-sent-at">Protected Preview Mode</span>
          </div>
          <div class="message message-system">
            Backend not connected. This is a UI preview only.
            <span class="message-sent-at">Protected Preview</span>
          </div>
        `;
        messageInput.disabled = true;
        sendBtn.disabled = true;
        document.querySelectorAll('.icon-btn').forEach(btn => btn.disabled = true);
      }
    }

    // Modal controls
    function openModal() {
      newProjectModal.classList.add('active');
      projectNameInput.value = '';
      projectNameInput.focus();
    }

    function closeModal() {
      newProjectModal.classList.remove('active');
    }

    // Create project
    function createProject() {
      const name = projectNameInput.value.trim();
      if (!name) return;

      const newProject = {
        id: `p-${Date.now()}`,
        name: name,
        type: document.getElementById('projectType').value,
        active: false,
      };

      projects.push(newProject);
      closeModal();
      renderProjects();
    }

    // Event listeners
    newProjectBtn.addEventListener('click', openModal);
    closeModalBtn.addEventListener('click', closeModal);
    cancelProjectBtn.addEventListener('click', closeModal);
    projectNameInput.addEventListener('input', () => {
      createProjectBtn.disabled = projectNameInput.value.trim().length === 0;
    });
    createProjectBtn.addEventListener('click', createProject);

    // Close modal on outside click
    newProjectModal.addEventListener('click', (e) => {
      if (e.target === newProjectModal) closeModal();
    });

    // Initialize
    renderProjects();
  </script>
</body>
</html>
