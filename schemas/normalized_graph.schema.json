{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Normalized Entity Graph",
  "description": "Normalized graph structure based on Weslr entity model",
  "required": ["entities", "relations"],
  "properties": {
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "attributes"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]{4,16}$",
            "description": "Unique entity identifier (lowercase alphanumeric, 4-16 chars)"
          },
          "type": {
            "type": "string",
            "enum": ["plc", "device", "tag", "alarm", "relationship"],
            "description": "Entity type"
          },
          "attributes": {
            "type": "object",
            "description": "Entity-specific attributes",
            "additionalProperties": true
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "default": 1.0,
            "description": "Confidence score for this entity"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Source evidence for this entity"
          }
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source_id", "target_id", "type"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]{4,16}$"
          },
          "source_id": {
            "type": "string",
            "description": "Reference to source entity id"
          },
          "target_id": {
            "type": "string",
            "description": "Reference to target entity id"
          },
          "type": {
            "type": "string",
            "enum": ["contains", "connects", "monitors", "triggers", "depends_on"],
            "description": "Relationship type"
          },
          "strength": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "default": 1.0
          },
          "provenance": {
            "type": "string",
            "description": "Source of this relationship"
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "default": "1.0.0"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "string"
        }
      }
    }
  }
}